/* ===========================================================================
 * LUMA TOOLS — STYLESHEET TEMPLATE
 *
 * This file is a TEMPLATE. Double-brace token placeholders are substituted from
 * python/core/design_tokens.py by design_tokens.render_qss(), called from
 * ui_components.load_stylesheet(). Never hardcode a colour or size here —
 * add the token to design_tokens.py and reference it.
 *
 * This sheet is applied ALONE. qdarkstyle is no longer concatenated
 * underneath it, so every widget class the application uses must be styled
 * here or it falls back to native platform chrome. scripts/ui_ayon.py has a
 * "zoo" scenario that renders every control type on one page for exactly
 * this check.
 *
 * Because nothing competes with us any more, this sheet needs zero priority
 * overrides. The previous version needed 84 of them. Keep the count at zero.
 *
 * Direction B — "Elevated & calm": panels sit lighter than the page, carry
 * no border, and lift with a hairline highlight and a soft radius. Qt has no
 * box-shadow; contrast and radius do the work.
 * =========================================================================== */


/* ===========================================================================
 * 1. BASE
 * =========================================================================== */

QWidget {
    background-color: {{color.page}};
    color: {{color.text}};
    font-family: {{font.family}};
    font-size: {{font.body}}px;
}

QWidget:disabled {
    color: {{color.disabled_text}};
}

QMainWindow,
QDialog {
    background-color: {{color.page}};
}

/* Panels and other explicitly-styled frames opt in via [variant]; a bare
   QFrame stays transparent so it does not paint boxes inside layouts. */
QFrame {
    background-color: transparent;
    border: none;
}

QFrame[variant="panel"] {
    background-color: {{color.panel}};
    border: none;
    border-top: 1px solid {{color.hairline}};
    border-radius: {{radius.md}}px;
}

QFrame[variant="subtle"],
QWidget[variant="subtle"] {
    background-color: {{color.panel_alt}};
    border: none;
    border-radius: {{radius.sm}}px;
}

/* A selectable row in a custom (non-QListWidget) list — the gallery groups
   panel builds its rows as plain widgets. */
QWidget[variant="row"] {
    background-color: transparent;
    border: none;
    border-radius: {{radius.xs}}px;
}

QWidget[variant="row"]:hover {
    background-color: {{color.hover}};
}

QWidget[variant="row"][state="active"] {
    background-color: {{color.selected}};
}

QWidget[variant="row"][state="drop"] {
    background-color: {{color.success_subtle}};
    border: 2px dashed {{color.success}};
}

/* A selectable card in a picker grid. */
QFrame[variant="card"] {
    background-color: {{color.panel_alt}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
}

QFrame[variant="card"]:hover {
    border-color: {{color.border_strong}};
}

QFrame[variant="card"][state="focused"] {
    border: 1px solid {{color.border_focus}};
}

QFrame[variant="card"][state="selected"] {
    background-color: {{color.accent_subtle}};
    border: 1px solid {{color.accent}};
}

/* An empty-state well: dashed, waiting to be filled. */
QFrame[variant="empty"] {
    background-color: {{color.sunken}};
    border: 1px dashed {{color.border_strong}};
    border-radius: {{radius.md}}px;
}

QFrame[variant="empty"][state="drop"] {
    background-color: {{color.accent_subtle}};
    border: 1px dashed {{color.accent}};
}

/* Full-bleed dimmer behind a modal overlay. */
QWidget[variant="backdrop"] {
    background-color: {{color.overlay_scrim}};
    border: none;
}

/* Thumbnail well at the top of a card. */
QLabel[variant="thumb"],
QFrame[variant="thumb"] {
    background-color: {{color.sunken}};
    color: {{color.text_muted}};
    border: none;
    border-top-left-radius: {{radius.md}}px;
    border-top-right-radius: {{radius.md}}px;
    font-size: {{font.help}}px;
}

QFrame[variant="sunken"] {
    background-color: {{color.sunken}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
}

/* Informational banner — tip, note, or a non-blocking warning. */
QFrame[variant="note"] {
    background-color: {{color.accent_subtle}};
    border: 1px solid {{color.accent}};
    border-radius: {{radius.sm}}px;
}

QFrame[variant="note"][state="success"] {
    background-color: {{color.success_subtle}};
    border-color: {{color.success}};
}

QFrame[variant="note"][state="warning"] {
    background-color: rgba(245, 158, 11, 0.12);
    border-color: {{color.warning}};
}

QFrame[variant="note"][state="error"] {
    background-color: rgba(239, 68, 68, 0.12);
    border-color: {{color.danger}};
}

/* Media review surround — image, video and 3D viewers. Neutral and darker
   than the app chrome so it does not tint the thing being reviewed. */
QWidget[variant="canvas"],
QFrame[variant="canvas"],
QLabel[variant="canvas"] {
    background-color: {{color.canvas}};
    border: none;
}

/* Toolbars and info bars floating over a canvas. */
QWidget[variant="transparent"],
QFrame[variant="transparent"],
QLabel[variant="transparent"] {
    background-color: transparent;
    border: none;
}

QFrame[variant="divider"] {
    background-color: {{color.border}};
    border: none;
    max-height: 1px;
    min-height: 1px;
}


/* ===========================================================================
 * 2. TABS
 * =========================================================================== */

QTabWidget::pane {
    background-color: {{color.page}};
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
}

QTabBar {
    background-color: {{color.page}};
    border: none;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: transparent;
    color: {{color.text_secondary}};
    border: none;
    border-top-left-radius: {{radius.sm}}px;
    border-top-right-radius: {{radius.sm}}px;
    padding: 0px {{space.xl}}px;
    margin-right: {{space.xxs}}px;
    min-height: {{size.tab_height}}px;
    font-size: {{font.body}}px;
    font-weight: {{font.weight_medium}};
}

QTabBar::tab:hover:!selected {
    background-color: {{color.hover}};
    color: {{color.text}};
}

QTabBar::tab:selected {
    background-color: {{color.panel}};
    color: {{color.text}};
}

QTabBar::tab:disabled {
    color: {{color.disabled_text}};
}

/* Nested tab bars (Cleaner sub-tabs, Settings sections) sit on panel, not
   page, so they need the inverse relationship to read as raised. */
QFrame[variant="panel"] > QTabWidget::pane,
QFrame[variant="panel"] QTabBar {
    background-color: {{color.panel}};
}

QFrame[variant="panel"] QTabBar::tab:selected {
    background-color: {{color.panel_alt}};
}


/* ===========================================================================
 * 3. GROUP BOX
 *
 * Retained for the tabs that have not been relaid out yet. Restyled to read
 * as a panel with a plain heading rather than a floating title chip.
 * =========================================================================== */

/* The title sits INSIDE the panel. With the default margin origin it floats
   above a detached box, which reads as a stray heading rather than a titled
   panel. Border origin plus top padding puts it in the panel's own header
   area, so the panel is one object. */
QGroupBox {
    background-color: {{color.panel}};
    border: none;
    border-top: 1px solid {{color.hairline}};
    border-radius: {{radius.md}}px;
    margin-top: 0px;
    padding: 46px {{space.panel_padding}}px {{space.panel_padding}}px {{space.panel_padding}}px;
    font-size: {{font.title}}px;
    font-weight: {{font.weight_semibold}};
}

QGroupBox::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    left: {{space.panel_padding}}px;
    top: {{space.lg}}px;
    padding: 0px;
    background-color: transparent;
    color: {{color.text}};
    font-size: {{font.title}}px;
    font-weight: {{font.weight_semibold}};
}

/* A group box with no title should not reserve header space. */
QGroupBox[flat="true"] {
    padding-top: {{space.panel_padding}}px;
}


/* ===========================================================================
 * 4. BUTTONS
 *
 * Rank is expressed with [role]. Exactly one role="primary" per panel.
 * danger is reserved for destructive actions, ayon for AYON publishing.
 * =========================================================================== */

QPushButton {
    background-color: {{color.panel_alt}};
    color: {{color.text}};
    border: none;
    border-radius: {{radius.sm}}px;
    padding: 0px {{space.lg}}px;
    min-height: {{size.control}}px;
    font-size: {{font.body}}px;
    font-weight: {{font.weight_medium}};
}

QPushButton:hover {
    background-color: {{color.hover}};
}

QPushButton:pressed {
    background-color: {{color.selected}};
}

QPushButton:disabled {
    background-color: {{color.disabled_bg}};
    color: {{color.disabled_text}};
}

QPushButton:focus {
    outline: none;
    border: 1px solid {{color.border_focus}};
}

/* --- primary ------------------------------------------------------------ */
QPushButton[role="primary"] {
    background-color: {{color.accent}};
    color: {{color.text_on_accent}};
    border: none;
    border-radius: {{radius.sm}}px;
    min-height: {{size.control_lg}}px;
    font-weight: {{font.weight_semibold}};
}

QPushButton[role="primary"]:hover {
    background-color: {{color.accent_hover}};
}

QPushButton[role="primary"]:pressed {
    background-color: {{color.accent_pressed}};
}

QPushButton[role="primary"]:disabled {
    background-color: {{color.disabled_bg}};
    color: {{color.disabled_text}};
}

/* --- secondary ---------------------------------------------------------- */
QPushButton[role="secondary"] {
    background-color: {{color.panel_alt}};
    color: {{color.text}};
}

QPushButton[role="secondary"]:hover {
    background-color: {{color.hover}};
}

/* --- ghost -------------------------------------------------------------- */
QPushButton[role="ghost"] {
    background-color: transparent;
    color: {{color.text_secondary}};
    border: 1px solid {{color.border_strong}};
}

QPushButton[role="ghost"]:hover {
    background-color: {{color.hover}};
    color: {{color.text}};
    border-color: {{color.accent}};
}

QPushButton[role="ghost"]:disabled {
    background-color: transparent;
    border-color: {{color.disabled_border}};
    color: {{color.disabled_text}};
}

/* --- danger ------------------------------------------------------------- */
QPushButton[role="danger"] {
    background-color: {{color.danger}};
    color: {{color.text_on_danger}};
    min-height: {{size.control_lg}}px;
    font-weight: {{font.weight_semibold}};
}

QPushButton[role="danger"]:hover {
    background-color: {{color.danger_hover}};
}

QPushButton[role="danger"]:pressed {
    background-color: {{color.danger_pressed}};
}

QPushButton[role="danger"]:disabled {
    background-color: {{color.disabled_bg}};
    color: {{color.disabled_text}};
}

/* --- ayon --------------------------------------------------------------- */
QPushButton[role="ayon"] {
    background-color: {{color.ayon}};
    color: {{color.text_on_accent}};
    min-height: {{size.control_lg}}px;
    font-weight: {{font.weight_semibold}};
}

QPushButton[role="ayon"]:hover {
    background-color: {{color.ayon_hover}};
}

QPushButton[role="ayon"]:pressed {
    background-color: {{color.ayon_pressed}};
}

QPushButton[role="ayon"]:disabled {
    background-color: {{color.disabled_bg}};
    color: {{color.disabled_text}};
}

/* --- link --------------------------------------------------------------- */
/* Text-only affordance with no chrome: disclosure toggles, "show more". */
QPushButton[role="link"] {
    background-color: transparent;
    color: {{color.text_muted}};
    border: none;
    border-radius: 0px;
    padding: 2px 0px;
    min-height: 0px;
    text-align: left;
    font-size: {{font.help}}px;
    font-weight: {{font.weight_normal}};
}

QPushButton[role="link"]:hover {
    background-color: transparent;
    color: {{color.accent}};
}

QPushButton[role="link"]:pressed {
    background-color: transparent;
    color: {{color.accent_pressed}};
}

QPushButton[role="link"]:disabled {
    background-color: transparent;
    color: {{color.disabled_text}};
}

/* --- ready ring ---------------------------------------------------------- */
/* Draws attention to the action that is now available without overwriting the
   fill, so an AYON button stays green and a destructive one stays red. */
QPushButton[ready="true"] {
    border: 2px solid {{color.accent}};
}

QPushButton[role="ayon"][ready="true"] {
    border: 2px solid {{color.ayon_hover}};
}

QPushButton[role="danger"][ready="true"] {
    border: 2px solid {{color.danger_hover}};
}

QPushButton[role="primary"][ready="true"] {
    border: 2px solid {{color.text}};
}

/* --- menu affordance ----------------------------------------------------- */
/* Buttons that open a menu (the OptionButtonManager pattern) get the same
   chevron as a combo box. Left unstyled, Qt paints a raw black triangle over
   the label. */
QPushButton::menu-indicator {
    image: url({{icon.chevron_down}});
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 12px;
    height: 12px;
    right: {{space.sm}}px;
}

QPushButton::menu-indicator:hover {
    image: url({{icon.chevron_down_accent}});
}

QPushButton[iconOnly="true"]::menu-indicator {
    image: none;
    width: 0px;
}

/* Reserve room for the chevron so the label does not run underneath it. */
QPushButton[hasMenu="true"] {
    padding-right: {{space.xxl}}px;
    text-align: left;
    padding-left: {{space.md}}px;
}

/* --- state tints -------------------------------------------------------- */
/* Layered on top of whatever role the button carries — these only recolour
   the label, so a ghost "Add" reads green and a ghost "Delete" reads red
   without needing a role of their own. */
QPushButton[state="success"] { color: {{color.success}}; }
QPushButton[state="error"]   { color: {{color.danger}}; }
QPushButton[state="warning"] { color: {{color.warning}}; }

/* A filter/toggle button that is currently applied. */
QPushButton[state="active"] {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
}

QPushButton[state="active"]:hover {
    background-color: {{color.hover}};
}

/* --- compact / icon ----------------------------------------------------- */
QPushButton[density="sm"] {
    min-height: {{size.control_sm}}px;
    padding: 0px {{space.md}}px;
    font-size: {{font.label}}px;
}

QPushButton[iconOnly="true"] {
    padding: 0px;
    min-width: {{size.control}}px;
    max-width: {{size.control}}px;
}

QPushButton:checked {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
}

/* --- tool buttons ------------------------------------------------------- */
/* Tool buttons are often given a fixed width in code, so they get the smaller
   type size and minimal horizontal padding — the default body size plus 4px
   each side elides short labels like "AUTO" to "A...O". */
QToolButton {
    background-color: transparent;
    color: {{color.text_secondary}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.xs}}px;
    padding: 0px 2px;
    min-height: {{size.control_sm}}px;
    font-size: {{font.label}}px;
}

QToolButton:hover {
    background-color: {{color.hover}};
    color: {{color.text}};
    border-color: {{color.accent}};
}

QToolButton:pressed,
QToolButton:checked {
    background-color: {{color.accent_subtle}};
    border-color: {{color.accent}};
    color: {{color.accent}};
}

QToolButton:disabled {
    border-color: {{color.disabled_border}};
    color: {{color.disabled_text}};
}

QToolButton::menu-indicator {
    image: none;
}

/* --- dialog button box -------------------------------------------------- */
QDialogButtonBox QPushButton {
    min-width: 88px;
}


/* ===========================================================================
 * 5. TEXT INPUT
 * =========================================================================== */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: {{color.sunken}};
    color: {{color.text}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xs}}px {{space.sm}}px;
    selection-background-color: {{color.accent}};
    selection-color: {{color.text_on_accent}};
}

QLineEdit {
    min-height: {{size.control}}px;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: {{color.border_strong}};
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: {{color.border_focus}};
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: {{color.disabled_bg}};
    border-color: {{color.disabled_border}};
    color: {{color.disabled_text}};
}

/* Validation failure — set via set_role(widget, state="error") so Qt
   re-polishes, then cleared with state=None. */
QLineEdit[state="error"],
QTextEdit[state="error"],
QPlainTextEdit[state="error"] {
    border: 1px solid {{color.danger}};
    background-color: {{color.danger_subtle}};
}

QLineEdit[state="drop"] {
    border: 2px solid {{color.accent}};
    background-color: {{color.accent_subtle}};
}

QLineEdit[state="warning"] {
    border: 1px solid {{color.warning}};
    background-color: {{color.warning_subtle}};
}

QLineEdit:read-only,
QTextEdit:read-only,
QPlainTextEdit:read-only {
    background-color: {{color.page}};
    color: {{color.text_secondary}};
}

QTextEdit[textRole="mono"],
QPlainTextEdit[textRole="mono"],
QLineEdit[textRole="mono"] {
    font-family: {{font.mono_family}};
}


/* ===========================================================================
 * 6. COMBO BOX
 * =========================================================================== */

QComboBox {
    background-color: {{color.sunken}};
    color: {{color.text}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 0px {{space.sm}}px;
    min-height: {{size.control}}px;
}

QComboBox:hover {
    border-color: {{color.border_strong}};
}

QComboBox:focus,
QComboBox:on {
    border-color: {{color.border_focus}};
}

QComboBox:disabled {
    background-color: {{color.disabled_bg}};
    border-color: {{color.disabled_border}};
    color: {{color.disabled_text}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: {{space.xxl}}px;
    border: none;
    background: transparent;
}

/* Real SVG assets, generated from the tokens by design_tokens.ensure_icons().
   The CSS-triangle trick renders as a clipped dash in this Qt build. */
QComboBox::down-arrow {
    image: url({{icon.chevron_down}});
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:on,
QComboBox::down-arrow:hover {
    image: url({{icon.chevron_down_accent}});
}

QComboBox::down-arrow:disabled {
    image: url({{icon.chevron_down_disabled}});
}

QComboBox QAbstractItemView {
    background-color: {{color.panel}};
    color: {{color.text}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xxs}}px;
    outline: none;
    selection-background-color: {{color.accent_subtle}};
    selection-color: {{color.text}};
}

QComboBox QAbstractItemView::item {
    border-radius: {{radius.xs}}px;
    padding: {{space.xs}}px {{space.sm}}px;
    min-height: {{size.control_sm}}px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{color.hover}};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
}


/* ===========================================================================
 * 7. SPIN BOXES
 * =========================================================================== */

QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: {{color.sunken}};
    color: {{color.text}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 0px {{space.sm}}px;
    min-height: {{size.control}}px;
    selection-background-color: {{color.accent}};
    selection-color: {{color.text_on_accent}};
}

QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover {
    border-color: {{color.border_strong}};
}

QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border-color: {{color.border_focus}};
}

QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled {
    background-color: {{color.disabled_bg}};
    border-color: {{color.disabled_border}};
    color: {{color.disabled_text}};
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: {{space.lg}}px;
    border: none;
    border-top-right-radius: {{radius.sm}}px;
    background-color: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: {{space.lg}}px;
    border: none;
    border-bottom-right-radius: {{radius.sm}}px;
    background-color: transparent;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: {{color.hover}};
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow {
    image: url({{icon.chevron_up}});
    width: 11px;
    height: 11px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow {
    image: url({{icon.chevron_down}});
    width: 11px;
    height: 11px;
}

QSpinBox::up-arrow:hover,
QDoubleSpinBox::up-arrow:hover {
    image: url({{icon.chevron_up_accent}});
}

QSpinBox::down-arrow:hover,
QDoubleSpinBox::down-arrow:hover {
    image: url({{icon.chevron_down_accent}});
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
    image: url({{icon.chevron_up_disabled}});
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
    image: url({{icon.chevron_down_disabled}});
}


/* ===========================================================================
 * 8. CHECKBOX / RADIO
 * =========================================================================== */

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: {{color.text}};
    spacing: {{space.sm}}px;
    padding: {{space.xxs}}px 0px;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: {{color.disabled_text}};
}

QCheckBox[state="ayon"]    { color: {{color.ayon}}; }
QCheckBox[state="success"] { color: {{color.success}}; }
QCheckBox[state="warning"] { color: {{color.warning}}; }
QCheckBox[state="error"]   { color: {{color.danger}}; }

QCheckBox::indicator,
QRadioButton::indicator {
    width: {{size.icon}}px;
    height: {{size.icon}}px;
}

QCheckBox::indicator {
    background-color: {{color.sunken}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.xs}}px;
}

QCheckBox::indicator:hover {
    border-color: {{color.accent}};
}

QCheckBox::indicator:checked {
    background-color: {{color.accent}};
    border-color: {{color.accent}};
}

QCheckBox::indicator:indeterminate {
    background-color: {{color.accent_subtle}};
    border-color: {{color.accent}};
}

QCheckBox::indicator:disabled {
    background-color: {{color.disabled_bg}};
    border-color: {{color.disabled_border}};
}

/* The dot is painted with a radial gradient rather than by thickening the
   border on :checked — changing border width changes the box model, which
   makes the indicator jump and render square. */
QRadioButton::indicator {
    background-color: {{color.sunken}};
    border: 1px solid {{color.border_strong}};
    border-radius: 9px;
}

QRadioButton::indicator:hover {
    border-color: {{color.accent}};
}

QRadioButton::indicator:checked {
    border-color: {{color.accent}};
    background-color: qradialgradient(
        cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
        stop:0 {{color.accent}},
        stop:0.55 {{color.accent}},
        stop:0.6 {{color.sunken}},
        stop:1 {{color.sunken}});
}

QRadioButton::indicator:disabled {
    background-color: {{color.disabled_bg}};
    border-color: {{color.disabled_border}};
}


/* ===========================================================================
 * 9. SLIDER
 * =========================================================================== */

QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    background-color: {{color.sunken}};
    border: none;
    border-radius: 3px;
    height: 6px;
}

QSlider::sub-page:horizontal {
    background-color: {{color.accent}};
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: {{color.text}};
    border: none;
    border-radius: 8px;
    width: {{size.icon}}px;
    height: {{size.icon}}px;
    margin: -5px 0px;
}

QSlider::handle:horizontal:hover {
    background-color: {{color.accent_hover}};
}

QSlider::groove:vertical {
    background-color: {{color.sunken}};
    border: none;
    border-radius: 3px;
    width: 6px;
}

QSlider::add-page:vertical {
    background-color: {{color.accent}};
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: {{color.text}};
    border: none;
    border-radius: 8px;
    width: {{size.icon}}px;
    height: {{size.icon}}px;
    margin: 0px -5px;
}

QSlider:disabled {
    background: transparent;
}

QSlider::sub-page:horizontal:disabled,
QSlider::add-page:vertical:disabled {
    background-color: {{color.disabled_border}};
}

QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background-color: {{color.disabled_text}};
}

QDial {
    background-color: {{color.panel_alt}};
}


/* ===========================================================================
 * 10. PROGRESS BAR
 * =========================================================================== */

QProgressBar {
    background-color: {{color.sunken}};
    color: {{color.text_secondary}};
    border: none;
    border-radius: {{radius.xs}}px;
    text-align: center;
    min-height: {{space.xl}}px;
    font-size: {{font.help}}px;
}

QProgressBar::chunk {
    background-color: {{color.accent}};
    border-radius: {{radius.xs}}px;
}

QProgressBar[state="success"]::chunk {
    background-color: {{color.success}};
}

QProgressBar[state="error"]::chunk {
    background-color: {{color.danger}};
}

QProgressBar[state="busy"]::chunk {
    background-color: {{color.scanning}};
}

/* Slim, textless progress — inline job progress rather than a page-level bar. */
QProgressBar[variant="slim"] {
    min-height: {{space.sm}}px;
    max-height: {{space.sm}}px;
}


/* ===========================================================================
 * 11. ITEM VIEWS
 * =========================================================================== */

QListWidget,
QListView,
QTreeWidget,
QTreeView,
QTableWidget,
QTableView,
QColumnView {
    background-color: {{color.sunken}};
    alternate-background-color: {{color.panel}};
    color: {{color.text}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xxs}}px;
    outline: none;
    selection-background-color: {{color.selected}};
    selection-color: {{color.text}};
}

QListWidget::item,
QListView::item,
QTreeWidget::item,
QTreeView::item,
QTableWidget::item,
QTableView::item {
    background-color: transparent;
    border: none;
    border-radius: {{radius.xs}}px;
    padding: {{space.xs}}px {{space.sm}}px;
    min-height: {{size.row}}px;
}

QListWidget::item:hover,
QListView::item:hover,
QTreeWidget::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: {{color.hover}};
}

QListWidget::item:selected,
QListView::item:selected,
QTreeWidget::item:selected,
QTreeView::item:selected,
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: {{color.selected}};
    color: {{color.text}};
}

QListWidget:disabled,
QTreeWidget:disabled,
QTableWidget:disabled {
    background-color: {{color.disabled_bg}};
    color: {{color.disabled_text}};
}

QTreeView::branch {
    background: transparent;
}

QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: {{color.panel_alt}};
    color: {{color.text_secondary}};
    border: none;
    border-right: 1px solid {{color.border}};
    border-bottom: 1px solid {{color.border}};
    padding: {{space.xs}}px {{space.sm}}px;
    font-size: {{font.label}}px;
    font-weight: {{font.weight_medium}};
}

QHeaderView::section:hover {
    background-color: {{color.hover}};
    color: {{color.text}};
}

QTableCornerButton::section {
    background-color: {{color.panel_alt}};
    border: none;
}


/* ===========================================================================
 * 12. SCROLL AREA AND SCROLLBARS
 * =========================================================================== */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QAbstractScrollArea::corner {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: transparent;
    border: none;
    width: {{size.scrollbar}}px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: {{color.border_strong}};
    border-radius: 5px;
    min-height: {{space.xxl}}px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{color.text_muted}};
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
    height: {{size.scrollbar}}px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: {{color.border_strong}};
    border-radius: 5px;
    min-width: {{space.xxl}}px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{color.text_muted}};
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}


/* ===========================================================================
 * 13. LABELS
 * =========================================================================== */

QLabel {
    background-color: transparent;
    color: {{color.text}};
    border: none;
}

QLabel:disabled {
    color: {{color.disabled_text}};
}

QLabel[textRole="title"] {
    color: {{color.text}};
    font-size: {{font.title}}px;
    font-weight: {{font.weight_semibold}};
}

QLabel[textRole="display"] {
    color: {{color.text}};
    font-size: {{font.display}}px;
    font-weight: {{font.weight_semibold}};
}

QLabel[textRole="label"] {
    color: {{color.text_secondary}};
    font-size: {{font.label}}px;
    font-weight: {{font.weight_medium}};
}

QLabel[textRole="help"] {
    color: {{color.text_muted}};
    font-size: {{font.help}}px;
}

QLabel[textRole="value"] {
    color: {{color.text}};
    font-size: {{font.body}}px;
    font-weight: {{font.weight_semibold}};
}

QLabel[textRole="mono"] {
    color: {{color.text_secondary}};
    font-family: {{font.mono_family}};
    font-size: {{font.help}}px;
}

/* A large decorative glyph, e.g. a file-type icon in a properties dialog. */
QLabel[textRole="glyph"] {
    color: {{color.text_secondary}};
    font-size: 40px;
}

QLabel[textRole="micro"] {
    color: {{color.text_secondary}};
    font-size: {{font.micro}}px;
    font-weight: {{font.weight_semibold}};
    letter-spacing: {{font.micro_letter_spacing}};
}

QLabel[state="info"]    { color: {{color.accent}}; }
QLabel[state="ayon"]    { color: {{color.ayon}}; }
QLabel[state="success"] { color: {{color.success}}; }
QLabel[state="warning"] { color: {{color.warning}}; }
QLabel[state="error"]   { color: {{color.danger}}; }
QLabel[state="busy"]    { color: {{color.scanning}}; }

/* A read-only path display: looks like a disabled input, not a label. */
QLabel[variant="path"] {
    background-color: {{color.sunken}};
    color: {{color.text_secondary}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    font-family: {{font.mono_family}};
    font-size: {{font.help}}px;
    padding: {{space.sm}}px {{space.md}}px;
}

/* An image or preview well. */
QLabel[variant="sunken"] {
    background-color: {{color.sunken}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
}

/* A cell in a comparison grid. Unstated = the two sides agree; state="a"
   and state="b" tint the two sides when they differ. */
QLabel[variant="cell"] {
    background-color: {{color.panel_alt}};
    color: {{color.text_secondary}};
    border-radius: {{radius.xs}}px;
    padding: {{space.xxs}}px {{space.sm}}px;
    font-size: {{font.help}}px;
}

QLabel[variant="cell"][state="a"] {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
    border-left: 2px solid {{color.accent}};
}

QLabel[variant="cell"][state="b"] {
    background-color: {{color.success_subtle}};
    color: {{color.success}};
    border-left: 2px solid {{color.success}};
}

/* A numbered step marker in an empty-state walkthrough. */
QLabel[variant="step"] {
    background-color: {{color.accent}};
    color: {{color.text_on_accent}};
    border-radius: 12px;
    font-size: {{font.label}}px;
    font-weight: {{font.weight_semibold}};
}

/* A count pill next to a list row label. */
QLabel[variant="count"] {
    background-color: {{color.panel_alt}};
    color: {{color.text_muted}};
    border-radius: {{radius.xs}}px;
    padding: 2px {{space.xs}}px;
    font-size: {{font.help}}px;
}

/* Selection tick pinned to a thumbnail corner. */
QLabel[variant="selectionBadge"] {
    background-color: {{color.scrim}};
    color: {{color.accent}};
    border: 2px solid {{color.accent}};
    border-radius: 12px;
    font-size: {{font.label}}px;
    font-weight: {{font.weight_semibold}};
}

/* Badge / chip */
QLabel[variant="badge"] {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
    border-radius: {{radius.xs}}px;
    padding: 2px {{space.sm}}px;
    font-size: {{font.micro}}px;
    font-weight: {{font.weight_semibold}};
}

QLabel[variant="badge"][state="success"] {
    background-color: {{color.ayon_subtle}};
    color: {{color.ayon}};
}


/* ===========================================================================
 * 14. MENUS
 * =========================================================================== */

QMenuBar {
    background-color: {{color.page}};
    color: {{color.text}};
    border: none;
}

QMenuBar::item {
    background: transparent;
    padding: {{space.xs}}px {{space.md}}px;
    border-radius: {{radius.xs}}px;
}

QMenuBar::item:selected {
    background-color: {{color.hover}};
}

QMenu {
    background-color: {{color.panel}};
    color: {{color.text}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xxs}}px;
}

QMenu::item {
    background-color: transparent;
    border-radius: {{radius.xs}}px;
    padding: {{space.xs}}px {{space.xl}}px {{space.xs}}px {{space.md}}px;
    min-height: {{space.xl}}px;
}

QMenu::item:selected {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
}

QMenu::item:disabled {
    color: {{color.disabled_text}};
}

QMenu::separator {
    background-color: {{color.border}};
    height: 1px;
    margin: {{space.xxs}}px {{space.sm}}px;
}

QMenu::icon {
    padding-left: {{space.sm}}px;
}


/* ===========================================================================
 * 15. TOOLTIP
 * =========================================================================== */

QToolTip {
    background-color: {{color.panel_alt}};
    color: {{color.text}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.xs}}px;
    padding: {{space.xs}}px {{space.sm}}px;
    font-size: {{font.label}}px;
}


/* ===========================================================================
 * 16. SPLITTER / STATUS BAR / MISC
 * =========================================================================== */

QSplitter::handle {
    background-color: {{color.border}};
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: {{color.accent}};
}

QStatusBar {
    background-color: {{color.page}};
    color: {{color.text_secondary}};
    border-top: 1px solid {{color.border}};
}

QStatusBar::item {
    border: none;
}

QFrame#statusBar {
    background-color: {{color.page}};
    border: none;
    border-top: 1px solid {{color.border}};
}

QSizeGrip {
    background: transparent;
    width: {{space.md}}px;
    height: {{space.md}}px;
}


/* ===========================================================================
 * 17. APPLICATION-SPECIFIC RULES
 *
 * These are ID-scoped leftovers from before the component contract existed.
 * They are retokenised here so nothing regresses, and are scheduled for
 * deletion in the component-contract pass — each one should become a
 * [role]/[text]/[variant] property on the widget instead.
 * =========================================================================== */

/* --- utility buttons: Settings / Logs in the tab-bar corner -------------- */
/* Settings / Logs in the tab-bar corner. Sized to the tab row so they sit
   flush in it; the checked marker is a bottom rule to match tab selection. */
QPushButton[utility="true"] {
    background-color: transparent;
    color: {{color.text_secondary}};
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    min-height: {{size.tab_height}}px;
    max-height: {{size.tab_height}}px;
    min-width: 38px;
    max-width: 38px;
}

QPushButton[utility="true"]:hover {
    background-color: {{color.hover}};
    color: {{color.text}};
}

QPushButton[utility="true"]:checked {
    background-color: {{color.panel}};
    color: {{color.accent}};
    border-bottom: 2px solid {{color.accent}};
}

#UtilityButtonContainer {
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

/* --- ComfyUI ------------------------------------------------------------- */
/* EditableNodeCard is constructed in Python (comfyui/ui_manager.py), not in a
   .ui file, so it keeps an ID selector until that construction sets
   variant="subtle" itself. */
#EditableNodeCard {
    background-color: {{color.panel_alt}};
    border: none;
    border-radius: {{radius.sm}}px;
    margin-bottom: {{space.sm}}px;
    padding: {{space.md}}px;
}

#EditableNodeCard QLabel {
    color: {{color.accent}};
    font-size: {{font.micro}}px;
    font-weight: {{font.weight_semibold}};
}

/* ===========================================================================
 * 18. MEDIA CHROME
 *
 * Controls that float over a review canvas rather than sitting in a panel.
 * They need their own treatment because the canvas is darker than the app
 * and because they overlay the content being reviewed.
 * =========================================================================== */

/* Rounded control bar over the media. */
QWidget[variant="scrim"] {
    background-color: {{color.scrim}};
    border: none;
    border-radius: {{radius.sm}}px;
}

/* Big round transport button. */
QPushButton[media="play"] {
    background-color: {{color.accent}};
    color: {{color.text_on_accent}};
    border: none;
    border-radius: 22px;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
    padding: 0px;
    font-size: {{font.display}}px;
    font-weight: {{font.weight_semibold}};
}

QPushButton[media="play"]:hover {
    background-color: {{color.accent_hover}};
}

QPushButton[media="play"]:pressed {
    background-color: {{color.accent_pressed}};
}

/* Small icon control on the scrim bar (volume, loop). */
QPushButton[media="icon"] {
    background-color: transparent;
    color: {{color.text}};
    border: none;
    border-radius: {{radius.pill}}px;
    padding: 0px;
    min-height: {{size.control_sm}}px;
}

QPushButton[media="icon"]:hover {
    background-color: {{color.canvas_chrome_hover}};
}

QPushButton[media="icon"]:checked {
    color: {{color.accent}};
}

/* Full-height previous/next arrows at the canvas edges. */
QPushButton[media="nav"] {
    background-color: {{color.scrim_soft}};
    color: {{color.text}};
    border: none;
    border-radius: 0px;
    font-size: {{font.display}}px;
}

QPushButton[media="nav"]:hover {
    background-color: {{color.scrim_accent}};
}

QPushButton[media="nav"]:disabled {
    background-color: {{color.scrim_soft}};
    color: {{color.disabled_text}};
}

/* Favourite toggle pinned to a thumbnail or viewer corner. */
QPushButton[media="like"] {
    background-color: {{color.canvas_chrome}};
    color: {{color.text_secondary}};
    border: none;
    border-radius: 16px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 0px;
}

QPushButton[media="like"]:hover {
    background-color: {{color.canvas_chrome_hover}};
    color: {{color.text}};
}

QPushButton[media="like"][state="on"] {
    background-color: {{color.danger}};
    color: {{color.text_on_danger}};
}

QPushButton[media="like"][state="on"]:hover {
    background-color: {{color.danger_hover}};
}

/* --- Settings section nav ------------------------------------------------ */
QListWidget#SettingsNav {
    background-color: {{color.panel}};
    border: none;
    border-radius: {{radius.md}}px;
    padding: {{space.sm}}px;
}

QListWidget#SettingsNav::item {
    border-radius: {{radius.sm}}px;
    padding: {{space.sm}}px {{space.md}}px;
    min-height: {{size.control}}px;
    color: {{color.text_secondary}};
}

QListWidget#SettingsNav::item:hover {
    background-color: {{color.hover}};
    color: {{color.text}};
}

QListWidget#SettingsNav::item:selected {
    background-color: {{color.accent_subtle}};
    color: {{color.accent}};
    font-weight: {{font.weight_semibold}};
}

/* --- Batch image selector ------------------------------------------------ */
BatchImageSelector {
    background-color: transparent;
}

BatchImageSelector QListWidget {
    background-color: {{color.sunken}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
}

/* ============================================================================
 * LUMA SHOT TOOLS - UI STYLESHEET
 *
 * ============================================================================ */

/* ============================================================================
 * COLOR PALETTE
 * ============================================================================ */
/* Primary Colors:
 * - Background Dark: #1a1a1a
 * - Background Card: #242424
 * - Surface: #2d2d2d
 * - Accent Blue: #3b82f6 
 * - Accent Blue Hover: #60a5fa
 * - Accent Blue Active: #2563eb
 * - Success Green: #10b981
 * - Warning Orange: #f59e0b
 * - Danger Red: #ef4444
 * - Text Primary: #f5f5f5
 * - Text Secondary: #a1a1a1
 * - Border: #404040
 */

/* ============================================================================
 * BASE WIDGET STYLING
 * ============================================================================ */
QWidget {
    background-color: #1a1a1a;
    color: #f5f5f5;
    font-family: "Segoe UI", "San Francisco", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 10pt;
}

/* ============================================================================
 * TAB WIDGET - 
 * ============================================================================ */
QTabWidget::pane {
    border: none;
    background-color: #1a1a1a;
    border-radius: 0px;
    padding: 0px;
}

QTabBar {
    background-color: #0a0a0a;
    border-bottom: 2px solid #2a2a2a;
    min-height: 50px;
}

QTabBar::tab {
    background-color: transparent;
    color: #888888;
    padding: 16px 32px;
    margin-right: 4px;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: 700;
    font-size: 11pt;
    width: 140px;
}

QTabBar::tab:hover {
    background-color: rgba(59, 130, 246, 0.08);
    color: #b8b8b8;
}

QTabBar::tab:selected {
    background-color: #1a1a1a;
    color: #ffffff;
    border-bottom: 3px solid #3b82f6;
}

/* ============================================================================
 * GROUP BOXES 
 * ============================================================================ */
QGroupBox {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 10px;
    margin-top: 28px;
    padding: 20px;
    padding-top: 44px;
    font-weight: 600;
    font-size: 11pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 6px 14px;
    background-color: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 5px;
    color: #e0e0e0;
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    left: 14px;
    top: 12px;
}

/* ============================================================================
 * PRIMARY BUTTONS - HERO ACTIONS
 * ============================================================================ */
QPushButton#BuildPasses,
QPushButton#MP4Generate {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4f92ff, stop:1 #3b82f6);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13pt;
    border-radius: 10px;
    padding: 18px 36px;
    letter-spacing: 0.8px;
    min-height: 52px;
    text-transform: uppercase;
}

QPushButton#BuildPasses:hover:enabled,
QPushButton#MP4Generate:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #60a5fa, stop:1 #4f92ff);
    border: 1px solid rgba(96, 165, 250, 0.4);
}

QPushButton#BuildPasses:pressed:enabled,
QPushButton#MP4Generate:pressed:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2563eb, stop:1 #1d4ed8);
    padding: 19px 35px 17px 37px;
}

QPushButton#BuildPasses:disabled,
QPushButton#MP4Generate:disabled {
    background: #252525;
    color: #555555;
    border: 1px solid #333333;
}

/* ============================================================================
 * DANGER BUTTON - DESTRUCTIVE ACTIONS
 * ============================================================================ */
QPushButton#CleanFiles {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ef4444, stop:1 #dc2626);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 11pt;
    border-radius: 8px;
    padding: 14px 28px;
    letter-spacing: 0.5px;
    min-height: 40px;
}

QPushButton#CleanFiles:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f87171, stop:1 #ef4444);
}

QPushButton#CleanFiles:pressed:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #dc2626, stop:1 #b91c1c);
    padding: 16px 26px 12px 30px;
}

/* ============================================================================
 * SECONDARY BUTTONS - UTILITY ACTIONS
 * ============================================================================ */
QPushButton {
    background-color: #282828;
    color: #e0e0e0;
    border: 1px solid #3a3a3a;
    border-radius: 7px;
    padding: 11px 22px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 38px;
}

QPushButton:hover {
    background-color: #323232;
    border-color: #4a4a4a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #222222;
    border-color: #3b82f6;
}

QPushButton:disabled {
    background-color: #1d1d1d;
    color: #555555;
    border-color: #2a2a2a;
}

/* ============================================================================
 * LIST WIDGETS 
 * ============================================================================ */
QListWidget {
    background-color: #181818;
    border: 1px solid #333333;
    border-radius: 8px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    background-color: transparent;
    color: #d0d0d0;
    padding: 12px 14px;
    border-radius: 6px;
    margin: 2px 0px;
    border: 1px solid transparent;
    font-size: 10pt;
}

QListWidget::item:hover {
    background-color: rgba(59, 130, 246, 0.12);
    border-color: rgba(59, 130, 246, 0.3);
    color: #ffffff;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3b82f6, stop:1 #2563eb);
    border-color: #60a5fa;
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:selected:active {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4f92ff, stop:1 #3b82f6);
}

QListWidget:disabled {
    background-color: #1a1a1a;
    border-color: #2a2a2a;
}

/* ============================================================================
 * LABELS 
 * ============================================================================ */
QLabel {
    color: #f5f5f5;
    background-color: transparent;
    border: none;
}

QLabel#RenderPath,
QLabel#MP4RenderPath,
QLabel#RePublishRenderPath {
    background-color: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 7px;
    padding: 14px 18px;
    color: #70b0ff;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    min-height: 40px;
}

QLabel#passesHint,
QLabel#MP4CustomPathLabel,
QLabel#MP4OutputPath,
QLabel#RePublishCustomPathLabel {
    color: #a1a1a1;
    font-style: italic;
    font-size: 10pt;
    padding: 4px 0px;
}

QLabel#StatusLabel {
    color: #3b82f6;
    font-weight: 600;
    font-size: 11pt;
    padding: 6px 0px;
}

QLabel#LatestRender,
QLabel#LatestUSD {
    color: #10b981;
    font-weight: 600;
    font-size: 10pt;
    padding: 6px 0px;
}

/* ============================================================================
 * SPIN BOXES
 * ============================================================================ */
QSpinBox {
    background-color: #282828;
    border: 1px solid #3a3a3a;
    border-radius: 7px;
    padding: 11px 16px;
    min-height: 38px;
    color: #e0e0e0;
    font-weight: 600;
    font-size: 10pt;
    selection-background-color: #3b82f6;
}

QSpinBox:hover {
    border-color: #4a4a4a;
    background-color: #2e2e2e;
}

QSpinBox:focus {
    border-color: #3b82f6;
    background-color: #282828;
    border-width: 2px;
    padding: 10px 15px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 40px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: rgba(59, 130, 246, 0.2);
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #a1a1a1;
    width: 0px;
    height: 0px;
    margin: 0px 6px;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a1a1a1;
    width: 0px;
    height: 0px;
    margin: 0px 6px;
}

/* ============================================================================
 * COMBO BOXES 
 * ============================================================================ */
QComboBox {
    background-color: #282828;
    border: 1px solid #3a3a3a;
    border-radius: 7px;
    padding: 11px 16px;
    min-height: 38px;
    color: #e0e0e0;
    font-weight: 600;
    font-size: 10pt;
    selection-background-color: #3b82f6;
}

QComboBox:hover {
    border-color: #4a4a4a;
    background-color: #2e2e2e;
}

QComboBox:focus {
    border-color: #3b82f6;
    border-width: 2px;
    padding: 10px 15px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #a1a1a1;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #282828;
    border: 2px solid #3b82f6;
    border-radius: 7px;
    selection-background-color: #3b82f6;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 10px 14px;
    min-height: 32px;
    font-size: 10pt;
    border-radius: 5px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(59, 130, 246, 0.15);
}

/* ============================================================================
 * CHECK BOXES
 * ============================================================================ */
QCheckBox {
    color: #f5f5f5;
    spacing: 10px;
    font-weight: 600;
    font-size: 10pt;
    padding: 4px 0px;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #404040;
    border-radius: 5px;
    background-color: #2d2d2d;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
    background-color: rgba(59, 130, 246, 0.1);
}

QCheckBox::indicator:checked {
    background-color: #3b82f6;
    border-color: #3b82f6;
    image: none;
}

QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #3b82f6, stop:1 #2563eb);
}

QCheckBox::indicator:checked::after {
    content: "✓";
    color: white;
}

/* ============================================================================
 * RADIO BUTTONS 
 * ============================================================================ */
QRadioButton {
    color: #f5f5f5;
    spacing: 10px;
    font-weight: 600;
    font-size: 10pt;
    padding: 4px 0px;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #404040;
    border-radius: 11px;
    background-color: #2d2d2d;
}

QRadioButton::indicator:hover {
    border-color: #3b82f6;
    background-color: rgba(59, 130, 246, 0.1);
}

QRadioButton::indicator:checked {
    background-color: #2d2d2d;
    border-color: #3b82f6;
    border-width: 6px;
}

/* ============================================================================
 * PROGRESS BAR 
 * ============================================================================ */
QProgressBar {
    background-color: #222222;
    border: 1px solid #333333;
    border-radius: 10px;
    text-align: center;
    font-weight: 700;
    color: #ffffff;
    font-size: 10pt;
    min-height: 36px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4f92ff, stop:1 #10b981);
    border-radius: 9px;
    margin: 1px;
}

/* ============================================================================
 * SCROLL BARS
 * ============================================================================ */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #404040;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #505050;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #404040;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #505050;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================================
 * STATUS FRAME 
 * ============================================================================ */
QFrame#statusBar {
    background-color: #242424;
    border: none;
    border-top: 1px solid #404040;
    border-radius: 0px;
}

/* ============================================================================
 * TOOL TIPS 
 * ============================================================================ */
QToolTip {
    background-color: #2d2d2d;
    color: #f5f5f5;
    border: 1px solid #3b82f6;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 9pt;
}

/* ============================================================================
 * TEXT EDIT - LOG OUTPUT
 * ============================================================================ */
QTextEdit {
    background-color: #0f0f0f;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    color: #c0c0c0;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    padding: 10px;
    selection-background-color: #3b82f6;
}

QTextEdit:focus {
    border-color: rgba(59, 130, 246, 0.5);
}

/* ============================================================================
 * LINE EDIT - TEXT INPUT
 * ============================================================================ */
QLineEdit {
    background-color: #282828;
    border: 1px solid #3a3a3a;
    border-radius: 7px;
    padding: 11px 16px;
    min-height: 38px;
    color: #e0e0e0;
    font-size: 10pt;
    selection-background-color: #3b82f6;
}

QLineEdit:hover {
    border-color: #4a4a4a;
    background-color: #2e2e2e;
}

QLineEdit:focus {
    border-color: #3b82f6;
    border-width: 2px;
    padding: 10px 15px;
}

/* ============================================================================
 * ANIMATIONS & TRANSITIONS
 * ============================================================================ */
QPushButton, QComboBox, QSpinBox, QListWidget::item, QCheckBox::indicator, QRadioButton::indicator {
    /* Smooth transitions handled by Qt's animation framework */
}

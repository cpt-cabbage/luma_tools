/* ============================================================================
 * LUMA SHOT TOOLS - UI STYLESHEET
 *
 * ============================================================================ */

/* ============================================================================
 * COLOR PALETTE - AYON THEME
 * ============================================================================ */
/* Primary Colors:
 * - Background Dark: #21252b
 * - Background Card: #282c34
 * - Surface: #2c313a
 * - Tab Background: #2c313a
 * - Accent Blue: #4a9eff
 * - Accent Blue Hover: #5cadff
 * - Accent Blue Active: #3a8eef
 * - Success Green: #10b981
 * - Warning Orange: #f59e0b
 * - Danger Red: #ef4444
 * - Text Primary: #c5cad3
 * - Text Secondary: #797e89
 * - Border: #3c414b
 */

/* ============================================================================
 * BASE WIDGET STYLING
 * ============================================================================ */
QWidget {
    background-color: #21252b;
    color: #c5cad3;
    font-family: "Segoe UI", "San Francisco", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 10pt;
}

/* ============================================================================
 * TAB WIDGET - AYON STYLE
 * ============================================================================ */
QTabWidget::pane {
    border: none;
    background-color: #21252b;
    border-radius: 0px;
    padding: 0px;
    margin-top: 0px;
}

QTabBar {
    background-color: #1a1d23 !important;
    border: none !important;
    border-bottom: 1px solid #2a2e36 !important;
}

QTabWidget::pane QTabBar::tab:top,
QDockWidget QTabBar::tab:top,
QTabBar::tab:top,
QTabBar::tab {
    background-color: rgba(74, 158, 255, 0.08) !important;
    color: #c5cad3 !important;
    padding: 10px 20px 10px 20px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    margin: 0px 0px 0px 0px !important;
    margin-top: 0px !important;
    margin-bottom: 0px !important;
    margin-left: 0px !important;
    margin-right: 0px !important;
    border: 0px solid transparent !important;
    border-top: 0px solid transparent !important;
    border-left: 0px solid transparent !important;
    border-right: 0px solid transparent !important;
    border-bottom: 2px solid transparent !important;
    font-weight: 500 !important;
    font-size: 10pt !important;
    /* width is calculated dynamically by ExpandingTabBar */
    height: 45px !important;
    min-height: 45px !important;
    max-height: 45px !important;
    text-align: center !important;
}

QTabWidget::pane QTabBar::tab:top:!selected:hover,
QDockWidget QTabBar::tab:top:!selected:hover,
QTabBar::tab:top:!selected:hover,
QTabBar::tab:!selected:hover,
QTabBar::tab:hover {
    background-color: rgba(74, 158, 255, 0.15) !important;
    color: #ffffff !important;
    padding: 10px 20px 10px 20px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    margin: 0px 0px 0px 0px !important;
    margin-top: 0px !important;
    margin-bottom: 0px !important;
    margin-left: 0px !important;
    margin-right: 0px !important;
    border: 0px solid transparent !important;
    border-top: 0px solid transparent !important;
    border-left: 0px solid transparent !important;
    border-right: 0px solid transparent !important;
    border-bottom: 2px solid transparent !important;
    text-align: center !important;
}

QTabWidget::pane QTabBar::tab:top:selected,
QDockWidget QTabBar::tab:top:selected,
QTabBar::tab:top:selected,
QTabBar::tab:selected {
    background-color: rgba(74, 158, 255, 0.35) !important;
    color: #ffffff !important;
    padding: 10px 20px 10px 20px !important;
    padding-top: 10px !important;
    padding-bottom: 10px !important;
    padding-left: 20px !important;
    padding-right: 20px !important;
    margin: 0px 0px 0px 0px !important;
    margin-top: 0px !important;
    margin-bottom: 0px !important;
    margin-left: 0px !important;
    margin-right: 0px !important;
    border: 0px solid transparent !important;
    border-top: 0px solid transparent !important;
    border-left: 0px solid transparent !important;
    border-right: 0px solid transparent !important;
    border-bottom: 2px solid #4a9eff !important;
    text-align: center !important;
}

/* ============================================================================
 * GROUP BOXES 
 * ============================================================================ */
QGroupBox {
    background-color: #282c34;
    border: 1px solid #3c414b;
    border-radius: 10px;
    margin-top: 6px;
    margin-bottom: 2px;
    padding: 8px;
    padding-top: 24px;
    font-weight: 600;
    font-size: 11pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 5px 12px;
    background-color: #2a3342;
    border: 1px solid #3d5a80;
    border-radius: 5px;
    color: #c5cad3;
    font-weight: 700;
    font-size: 9pt;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    left: 14px;
    top: 8px;
}

/* ============================================================================
 * PRIMARY BUTTONS - HERO ACTIONS
 * ============================================================================ */
QPushButton#BuildPasses,
QPushButton#MP4Generate {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #5cadff, stop:1 #4a9eff);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 13pt;
    border-radius: 10px;
    padding: 13px 36px;
    letter-spacing: 0.8px;
    min-height: 39px;
    text-transform: uppercase;
}

QPushButton#BuildPasses:hover:enabled,
QPushButton#MP4Generate:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6ebcff, stop:1 #5cadff);
    border: 1px solid rgba(92, 173, 255, 0.4);
}

QPushButton#BuildPasses:pressed:enabled,
QPushButton#MP4Generate:pressed:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3a8eef, stop:1 #2a7edf);
    padding: 14px 35px 12px 37px;
}

QPushButton#BuildPasses:disabled,
QPushButton#MP4Generate:disabled {
    background: #2c313a;
    color: #5a5f68;
    border: 1px solid #3c414b;
}

/* ============================================================================
 * DANGER BUTTON - DESTRUCTIVE ACTIONS
 * ============================================================================ */
QPushButton#CleanFiles {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #ef4444, stop:1 #dc2626);
    color: #ffffff;
    border: none;
    font-weight: 700;
    font-size: 11pt;
    border-radius: 8px;
    padding: 10px 28px;
    letter-spacing: 0.5px;
    min-height: 30px;
}

QPushButton#CleanFiles:hover:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f87171, stop:1 #ef4444);
}

QPushButton#CleanFiles:pressed:enabled {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #dc2626, stop:1 #b91c1c);
    padding: 11px 26px 9px 30px;
}

/* ============================================================================
 * SECONDARY BUTTONS - UTILITY ACTIONS
 * ============================================================================ */
QPushButton {
    background-color: #2c313a;
    color: #c5cad3;
    border: 1px solid #3c414b;
    border-radius: 7px;
    padding: 6px 16px;
    font-weight: 600;
    font-size: 10pt;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #353b47;
    border-color: #484e5a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #252933;
    border-color: #4a9eff;
}

QPushButton:disabled {
    background-color: #23272e;
    color: #5a5f68;
    border-color: #33373f;
}

/* ============================================================================
 * LIST WIDGETS 
 * ============================================================================ */
QListWidget {
    background-color: #1c2026;
    border: 1px solid #3c414b;
    border-radius: 8px;
    outline: none;
    padding: 6px;
}

QListWidget::item {
    background-color: transparent;
    color: #c5cad3;
    padding: 12px 14px;
    border-radius: 6px;
    margin: 2px 0px;
    border: 1px solid transparent;
    font-size: 10pt;
}

QListWidget::item:hover {
    background-color: rgba(74, 158, 255, 0.12);
    border-color: rgba(74, 158, 255, 0.3);
    color: #ffffff;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #4a9eff, stop:1 #3a8eef);
    border-color: #5cadff;
    color: #ffffff;
    font-weight: 600;
}

QListWidget::item:selected:active {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5cadff, stop:1 #4a9eff);
}

QListWidget:disabled {
    background-color: #21252b;
    border-color: #33373f;
}

/* ============================================================================
 * LABELS 
 * ============================================================================ */
QLabel {
    color: #f5f5f5;
    background-color: transparent;
    border: none;
}

QLabel#RenderPath,
QLabel#MP4RenderPath,
QLabel#RePublishRenderPath {
    background-color: rgba(74, 158, 255, 0.08);
    border: 1px solid rgba(74, 158, 255, 0.25);
    border-radius: 7px;
    padding: 14px 18px;
    color: #5cadff;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    min-height: 40px;
}

QLabel#passesHint,
QLabel#MP4CustomPathLabel,
QLabel#MP4OutputPath,
QLabel#RePublishCustomPathLabel {
    color: #797e89;
    font-style: italic;
    font-size: 10pt;
    padding: 4px 0px;
}

QLabel#StatusLabel {
    color: #4a9eff;
    font-weight: 600;
    font-size: 11pt;
    padding: 6px 0px;
}

QLabel#LatestRender,
QLabel#LatestUSD {
    color: #10b981;
    font-weight: 600;
    font-size: 10pt;
    padding: 6px 0px;
}

/* ============================================================================
 * SPIN BOXES
 * ============================================================================ */
QSpinBox {
    background-color: #2c313a;
    border: 1px solid #3c414b;
    border-radius: 7px;
    padding: 11px 16px;
    min-height: 38px;
    color: #c5cad3;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-weight: 500;
    font-size: 10pt;
    selection-background-color: #4a9eff;
}

QSpinBox:hover {
    border-color: #484e5a;
    background-color: #353b47;
}

QSpinBox:focus {
    border-color: #4a9eff;
    background-color: #2c313a;
    border-width: 2px;
    padding: 10px 15px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 40px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: rgba(74, 158, 255, 0.2);
}

QSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #a1a1a1;
    width: 0px;
    height: 0px;
    margin: 0px 6px;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #a1a1a1;
    width: 0px;
    height: 0px;
    margin: 0px 6px;
}

/* ============================================================================
 * COMBO BOXES
 * ============================================================================ */
QComboBox {
    background-color: #2c313a;
    border: 1px solid #3c414b;
    border-radius: 7px;
    padding: 11px 22px;
    min-height: 38px;
    color: #c5cad3;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-weight: 500;
    font-size: 10pt;
    selection-background-color: #4a9eff;
}

QComboBox:hover {
    border-color: #484e5a;
    background-color: #353b47;
}

QComboBox:focus {
    border-color: #4a9eff;
    border-width: 2px;
    padding: 10px 21px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #797e89;
    width: 0px;
    height: 0px;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2c313a;
    border: 2px solid #4a9eff;
    border-radius: 7px;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    padding: 11px 22px;
    min-height: 38px;
    font-size: 10pt;
    border-radius: 5px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(74, 158, 255, 0.15);
}

/* ============================================================================
 * CHECK BOXES
 * ============================================================================ */
QCheckBox {
    color: #f5f5f5;
    spacing: 10px;
    font-weight: 600;
    font-size: 10pt;
    padding: 4px 0px;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #484e5a;
    border-radius: 5px;
    background-color: #2c313a;
}

QCheckBox::indicator:hover {
    border-color: #4a9eff;
    background-color: rgba(74, 158, 255, 0.1);
}

QCheckBox::indicator:checked {
    background-color: #4a9eff;
    border-color: #4a9eff;
    image: none;
}

QCheckBox::indicator:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #4a9eff, stop:1 #3a8eef);
}

/* ============================================================================
 * RADIO BUTTONS 
 * ============================================================================ */
QRadioButton {
    color: #f5f5f5;
    spacing: 10px;
    font-weight: 600;
    font-size: 10pt;
    padding: 4px 0px;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #484e5a;
    border-radius: 11px;
    background-color: #2c313a;
}

QRadioButton::indicator:hover {
    border-color: #4a9eff;
    background-color: rgba(74, 158, 255, 0.1);
}

QRadioButton::indicator:checked {
    background-color: #2c313a;
    border-color: #4a9eff;
    border-width: 6px;
}

/* ============================================================================
 * PROGRESS BAR 
 * ============================================================================ */
QProgressBar {
    background-color: #252933;
    border: 1px solid #3c414b;
    border-radius: 10px;
    text-align: center;
    font-weight: 700;
    color: #ffffff;
    font-size: 10pt;
    min-height: 36px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #5cadff, stop:1 #4a9eff);
    border-radius: 9px;
    margin: 1px;
}

/* ============================================================================
 * SCROLL BARS
 * ============================================================================ */
QScrollBar:vertical {
    background-color: transparent;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #484e5a;
    min-height: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #585e6a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #484e5a;
    min-width: 30px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #585e6a;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* ============================================================================
 * STATUS FRAME 
 * ============================================================================ */
QFrame#statusBar {
    background-color: #282c34;
    border: none;
    border-top: 1px solid #3c414b;
    border-radius: 0px;
}

/* ============================================================================
 * TOOL TIPS 
 * ============================================================================ */
QToolTip {
    background-color: #2c313a;
    color: #c5cad3;
    border: 1px solid #4a9eff;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 9pt;
}

/* ============================================================================
 * TEXT EDIT - LOG OUTPUT
 * ============================================================================ */
QTextEdit {
    background-color: #181b20;
    border: 1px solid #3c414b;
    border-radius: 8px;
    color: #b0b5bd;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    padding: 10px;
    selection-background-color: #4a9eff;
}

QTextEdit:focus {
    border-color: rgba(74, 158, 255, 0.5);
}

/* ============================================================================
 * LINE EDIT - TEXT INPUT
 * ============================================================================ */
QLineEdit {
    background-color: #2c313a;
    border: 1px solid #3c414b;
    border-radius: 7px;
    padding: 11px 16px;
    min-height: 38px;
    color: #c5cad3;
    font-family: "Segoe UI", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
    font-weight: 500;
    font-size: 10pt;
    selection-background-color: #4a9eff;
}

QLineEdit:hover {
    border-color: #484e5a;
    background-color: #353b47;
}

QLineEdit:focus {
    border-color: #4a9eff;
    border-width: 2px;
    padding: 10px 15px;
}

/* ============================================================================
 * MODERN COMPONENTS - EXTENSIONS
 * ============================================================================ */

/* ComfyUI Specifics */
#EditableNodeCard {
    background-color: #2c313a;
    border: 1px solid #3c414b;
    border-radius: 8px;
    margin-bottom: 10px;
    padding: 10px;
}

#EditableNodeCard QLabel {
    color: #4a9eff;
    font-weight: 700;
    font-size: 8pt;
    text-transform: uppercase;
}

/* ============================================================================
 * UTILITY BUTTONS - Fixed Settings/Logs buttons in tab bar corner
 * ============================================================================ */
QPushButton[utility="true"] {
    background-color: rgba(74, 158, 255, 0.08) !important;
    color: #c5cad3 !important;
    border: none !important;
    border-left: 2px solid transparent !important;
    border-radius: 0px !important;
    padding: 0px !important;
    margin: 0px !important;
    min-height: 33px !important;
    max-height: 33px !important;
    min-width: 36px !important;
    max-width: 36px !important;
}

QPushButton[utility="true"]:hover {
    background-color: rgba(74, 158, 255, 0.15) !important;
    color: #ffffff !important;
    border: none !important;
    border-left: 2px solid transparent !important;
}

QPushButton[utility="true"]:checked {
    background-color: rgba(74, 158, 255, 0.35) !important;
    color: #ffffff !important;
    border: none !important;
    border-left: 2px solid #4a9eff !important;
}

#UtilityButtonContainer {
    background-color: transparent !important;
    padding: 0px !important;
    margin: 0px !important;
}

/* Batch Image Selector */
BatchImageSelector {
    background-color: transparent;
}

BatchImageSelector QListWidget {
    background-color: #1a1d23;
    border: 1px solid #3c414b;
    border-radius: 6px;
}

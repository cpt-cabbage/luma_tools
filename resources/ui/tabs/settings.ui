           <layout class="QHBoxLayout" name="performanceFlagsLayout">
            <item>
             <widget class="QCheckBox" name="ComfyUIFastMode">
              <property name="text">
               <string>Fast Mode (--fast)</string>
              </property>
              <property name="toolTip">
               <string>Enable --fast flag for faster execution. May slightly reduce quality for some models.</string>

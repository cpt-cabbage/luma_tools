             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="ComfyUIFP16Accumulation">
              <property name="text">
               <string>FP16 Accumulation (--fp16-accumulation)</string>
              </property>
              <property name="toolTip">
               <string>Enable --fp16-accumulation for faster FP16 math operations. Requires compatible GPU.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="ComfyUILowVRAM">
              <property name="text">
               <string>Low VRAM Mode (--lowvram)</string>
              </property>
              <property name="toolTip">
               <string>Enable --lowvram flag for systems with limited GPU memory. Reduces VRAM usage at the cost of performance.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="ComfyUIHighVRAM">
              <property name="text">
               <string>High VRAM Mode (--highvram)</string>
              </property>
              <property name="toolTip">
               <string>Keep models loaded in VRAM between inferences. Best for persistent server mode with high-end GPUs (24GB+).</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QCheckBox" name="ComfyUINormalVRAM">
              <property name="text">

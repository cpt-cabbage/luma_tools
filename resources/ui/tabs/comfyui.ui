                    <string>Custom name:</string>
                   </property>
                   <property name="checked">
                    <bool>false</bool>
                   </property>
                   <property name="toolTip">
                    <string>Add a custom label to output filenames for easier identification</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLineEdit" name="ComfyUIName">
                   <property name="placeholderText">
                    <string>Prefixes output filenames</string>
                   </property>
                   <property name="maxLength">
                    <number>60</number>
                   </property>
                   <property name="visible">
                    <bool>false</bool>
                   </property>
                  </widget>
                 </item>
                </layout>
               </item>

               <!-- Server behavior -->
               <item>
                <layout class="QHBoxLayout" name="serverBehaviorLayout">
                 <property name="spacing">
                  <number>6</number>
                 </property>
                 <item>
                  <widget class="QLabel" name="serverBehaviorLabel">
                   <property name="text">
                    <string>If server offline:</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QComboBox" name="ServerBehaviorCombo">
                   <property name="minimumWidth">
                    <number>140</number>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLabel" name="serverWaitTimeoutLabel">
                   <property name="text">
                    <string>Timeout:</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QSpinBox" name="ServerWaitTimeoutSpinBox">
                   <property name="minimum">
                    <number>1</number>
                   </property>
                   <property name="maximum">
                    <number>60</number>
                   </property>
                   <property name="value">
                    <number>5</number>
                   </property>
                   <property name="suffix">
                    <string> min</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <spacer>
                   <property name="orientation">
                    <enum>Qt::Horizontal</enum>
                   </property>
                  </spacer>
                 </item>
                </layout>
               </item>

               <!-- Network output path (hidden, for internal display) -->
               <item>
                <layout class="QHBoxLayout" name="networkOutputDisplayLayout">
                 <item>
                  <widget class="QLabel" name="label_network_output">
                   <property name="text">
                    <string>Output path:</string>
                   </property>
                   <property name="minimumWidth"><number>80</number></property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLabel" name="ComfyUINetworkPathDisplay">
                   <property name="sizePolicy">
                    <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
                     <horstretch>1</horstretch>
                     <verstretch>0</verstretch>
                    </sizepolicy>
                   </property>
                   <property name="text">
                    <string>(Not configured)</string>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">color: #797e89; font-style: italic; font-size: 11px;</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </item>
              </layout>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <!-- RIGHT: Submit card -->
         <item>
          <widget class="QFrame" name="comfyuiSubmitFrame">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
             <horstretch>1</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="styleSheet">
            <string notr="true">
              QFrame#comfyuiSubmitFrame {
                background-color: #282c34;
                border: 1px solid #3c414b;
                border-radius: 8px;
              }
            </string>
           </property>
           <layout class="QVBoxLayout" name="comfyuiSubmitLayout">
            <property name="spacing">
             <number>10</number>
            </property>
            <property name="leftMargin"><number>16</number></property>
            <property name="topMargin"><number>12</number></property>
            <property name="rightMargin"><number>16</number></property>
            <property name="bottomMargin"><number>14</number></property>

            <!-- Step header -->
            <item>
             <layout class="QHBoxLayout" name="submitHeaderLayout">
              <property name="spacing">
               <number>10</number>
              </property>
              <item>
               <widget class="QLabel" name="submitStepTitle">
                <property name="text">
                 <string>Submit</string>
                </property>
                <property name="styleSheet">
                 <string notr="true">color: #e0e0e0; font-size: 13px; font-weight: bold;</string>
                </property>
               </widget>
              </item>
              <item>
               <spacer>
                <property name="orientation">
                 <enum>Qt::Horizontal</enum>
                </property>
               </spacer>
              </item>
             </layout>
            </item>

            <!-- Server status banner area (populated programmatically) -->
            <item>
             <widget class="QFrame" name="serverStatusBanner">
              <property name="visible">
               <bool>false</bool>
              </property>
              <property name="minimumHeight">
               <number>32</number>
              </property>
              <layout class="QHBoxLayout" name="serverStatusLayout">
               <property name="leftMargin"><number>10</number></property>
               <property name="topMargin"><number>6</number></property>
               <property name="rightMargin"><number>10</number></property>
               <property name="bottomMargin"><number>6</number></property>
              </layout>
             </widget>
            </item>

            <!-- Submit + Cancel buttons -->
            <item>
             <layout class="QHBoxLayout" name="submitButtonsLayout">
              <property name="spacing">
               <number>8</number>
              </property>
              <item>
               <widget class="QPushButton" name="ComfyUISubmit">
                <property name="minimumSize">
                 <size><width>0</width><height>42</height></size>
                </property>
                <property name="text">
                 <string>Submit to Farm</string>
                </property>
                <property name="styleSheet">
                 <string notr="true">
                   QPushButton {
                     background-color: #4a9eff;
                     color: white;
                     border: none;
                     border-radius: 6px;
                     font-size: 13px;
                     font-weight: bold;
                     padding: 8px 24px;
                   }
                   QPushButton:hover {
                     background-color: #5cadff;
                   }
                   QPushButton:pressed {
                     background-color: #3a8eef;
                   }
                   QPushButton:disabled {
                     background-color: #3c414b;
                     color: #797e89;
                   }
                 </string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QPushButton" name="ComfyUICancelJobs">
                <property name="minimumSize">
                 <size><width>100</width><height>42</height></size>
                </property>
                <property name="text">
                 <string>Cancel Jobs</string>
                </property>
                <property name="visible">
                 <bool>false</bool>
                </property>
                <property name="styleSheet">
                 <string notr="true">
                   QPushButton {
                     background-color: #ef4444;
                     color: white;
                     border: none;
                     border-radius: 6px;
                     font-size: 12px;
                     font-weight: bold;
                     padding: 8px 16px;
                   }
                   QPushButton:hover {
                     background-color: #f87171;
                   }
                   QPushButton:disabled {
                     background-color: #3c414b;
                     color: #797e89;
                   }
                 </string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
        </widget>
       </item>

       <!-- ===== ITERATE MODE (hidden, shown during job) ===== -->
       <item>
        <widget class="QFrame" name="comfyuiIterateFrame">
         <property name="frameShape">
          <enum>QFrame::StyledPanel</enum>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
         <property name="styleSheet">
          <string notr="true">
            QFrame {
              background-color: #282c34;
              border: 1px solid #3c414b;
              border-radius: 8px;
            }
          </string>
         </property>
         <layout class="QVBoxLayout" name="iterateLayout">
          <property name="spacing">
           <number>8</number>
          </property>
          <property name="leftMargin"><number>16</number></property>
          <property name="topMargin"><number>12</number></property>
          <property name="rightMargin"><number>16</number></property>
          <property name="bottomMargin"><number>14</number></property>
          <item>
           <widget class="QLabel" name="ComfyUIIterateTitle">
            <property name="text">
             <string>Progress</string>
            </property>
            <property name="styleSheet">
             <string notr="true">font-weight: bold; font-size: 13px; color: #e0e0e0; border: none;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="ComfyUIIterateStatus">
            <property name="text">
             <string>Ready</string>
            </property>
            <property name="styleSheet">
             <string notr="true">color: #797e89; border: none;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QProgressBar" name="ComfyUIIterateProgress">
            <property name="maximum">
             <number>100</number>
            </property>
            <property name="value">
             <number>0</number>
            </property>
            <property name="textVisible">
             <bool>false</bool>
            </property>
            <property name="styleSheet">
             <string notr="true">
               QProgressBar {
                 background-color: #1a1d21;
                 border: none;
                 border-radius: 4px;
                 height: 8px;
               }
               QProgressBar::chunk {
                 background-color: #4a9eff;
                 border-radius: 4px;
               }
             </string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="ComfyUIIteratePreview">
            <property name="minimumSize">
             <size><width>200</width><height>200</height></size>
            </property>
            <property name="text">
             <string></string>
            </property>
            <property name="alignment">
             <set>Qt::AlignCenter</set>
            </property>
            <property name="styleSheet">
             <string notr="true">background-color: #1a1d21; border: 1px solid #3c414b; border-radius: 6px;</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="ComfyUIUseAsInput">
            <property name="text">
             <string>Use as Input for Next Run</string>
            </property>
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="styleSheet">
             <string notr="true">
               QPushButton {
                 background-color: #2c313a;
                 border: 1px solid #4a9eff;
                 border-radius: 6px;
                 color: #4a9eff;
                 padding: 8px 16px;
                 font-size: 12px;
               }
               QPushButton:hover {
                 background-color: #333842;
               }
               QPushButton:disabled {
                 border-color: #3c414b;
                 color: #797e89;
               }
             </string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- Bottom spacer -->
       <item>
        <spacer name="verticalSpacer_comfy">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
